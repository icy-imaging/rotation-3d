<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherited Icy Parent POM -->
    <parent>
        <groupId>org.bioimageanalysis.icy</groupId>
        <artifactId>pom-icy</artifactId>
        <version>2.2.0</version>
    </parent>

    <!-- Project Information -->
    <artifactId>3d-rotation</artifactId>
    <version>1.3.1</version>

    <packaging>jar</packaging>

    <name>3D Rotation</name>
    <description>Takes the active 3D VTK viewer and records a 360-degree rotation of the data into a video sequence.</description>
    <inceptionYear>2013</inceptionYear>

    <organization>
        <name>Institut Pasteur</name>
        <url>https://pasteur.fr</url>
    </organization>

    <licenses>
        <license>
            <name>GNU GPLv3</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.en.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>adufour</id>
            <name>Alexandre Dufour</name>
            <url>https://github.com/DrDaleks</url>
            <roles>
                <role>founder</role>
                <role>developer</role>
            </roles>
        </developer>
        <developer>
            <id>sdallongeville</id>
            <name>Stéphane Dallongeville</name>
            <url>https://research.pasteur.fr/fr/member/stephane-dallongeville/</url>
            <roles>
                <role>lead</role>
                <role>architect</role>
                <role>developer</role>
                <role>debugger</role>
                <role>tester</role>
                <role>maintainer</role>
                <role>support</role>
            </roles>
        </developer>
    </developers>

    <!-- List of project's dependencies -->
    <dependencies>
        <!-- The EzPlug library, simplifies writing UI for Icy plugins. -->
        <dependency>
            <groupId>org.bioimageanalysis.icy</groupId>
            <artifactId>ezplug</artifactId>
        </dependency>
    </dependencies>

    <!-- Icy Maven repository (to find parent POM) -->
    <repositories>
        <repository>
            <id>icy</id>
            <name>Icy's Nexus</name>
            <url>https://icy-nexus.pasteur.fr/repository/Icy/</url>
        </repository>
    </repositories>
</project>
